{
  "BggApi": {
    "BaseUrl": "https://boardgamegeek.com/xmlapi2",
    "UserAgent": "NextTurn/1.0 (contact: simon.steinschaden@outlook.at)",
    "RequestIntervalSeconds": 5
  },
  "Data": {
    "BoardGameRanksCsvPath": "data/boardgames_ranks.csv"
  },
  "Import": {
    "Enabled": true,
    "RefreshDays": 30
  },
  "Recommendations": {
    "CandidateLimit": 300,
    "PageSize": 20,
    "ExplorationRatio": 0.2
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient.bgg": "Warning"
    }
  },
  "AllowedHosts": "*"
}
